<%- include('../partials/header', { title: 'Instructor Dashboard - Puls8' }) %>
   <%- include('../partials/navbar') %>

      <div class="container mt-4">
         <h2 class="mb-4">Instructor Dashboard</h2>

         <!-- Search Form -->
         <form action="/instructor" method="GET" class="mb-4">
            <div class="input-group">
               <input type="text" class="form-control" name="search" placeholder="Search student emails...">
               <button type="submit" class="btn btn-primary">Search</button>
            </div>
         </form>

         <!-- Iterate over classData -->
         <% classData.forEach(cls => { %>
            <div class="card mb-4 shadow-sm">
               <div class="card-header bg-secondary text-white">
                  <h4 class="mb-0">Class: <%= cls.name %> (Phase <%= cls.phaseLevel %>)</h4>
               </div>
               <div class="card-body">
                  <table class="table table-striped table-hover">
                     <thead>
                        <tr>
                           <th>Student Email</th>
                           <th>Phase</th>
                           <th>Dossier</th>
                        </tr>
                     </thead>
                     <tbody>
                        <% cls.Users.forEach(user => { %>
                           <tr>
                              <td><%= user.email %></td>
                              <td><%= user.phaseLevel %></td>
                              <td><%= user.generateDossier() %></td>
                           </tr>
                        <% }) %>
                     </tbody>
                  </table>
               </div>
            </div>
         <% }) %>
      </div>

      <%- include('../partials/footer') %>