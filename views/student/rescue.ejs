<%- include('../partials/header', { title: 'Rescue Flare - Puls8' }) %>
  <%- include('../partials/navbar') %>

    <div class="container mt-4">
      <h2 class="mb-4 text-danger">Deploy Rescue Flare</h2>

      <form action="/student/rescue" method="POST" class="p-4 border rounded bg-light mb-4">
        <div class="mb-3">
          <label for="taskId" class="form-label">Select the Task you need help with:</label>

          <select name="taskId" id="taskId" class="form-select" required>
            <option value="" disabled selected>-- Select a Task --</option>
            <% if (typeof task !== 'undefined') { %>
              <% task.forEach(taskItem => { %>
                <option value="<%= taskItem.id %>"><%= taskItem.name %></option>
              <% }) %>
            <% } %>
          </select>
        </div>
        
        <button type="submit" class="btn btn-danger btn-lg w-100">
          🔥 Deploy Rescue Flare 🔥
        </button>
      </form>

    </div>

    <%- include('../partials/footer') %>