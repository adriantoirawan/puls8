<%- include('../partials/header', { title: 'Student Dashboard - Puls8' }) %>
  <%- include('../partials/navbar') %>

    <div class="container mt-4">
      <h2 class="mb-4">Student Dashboard</h2>

      <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
          <h4 class="mb-0">My Scores</h4>
        </div>
        <div class="card-body">
          <table class="table table-striped table-hover">
            <thead>
              <tr>
                <th>Task Name</th>
                <th>Weight</th>
                <th>Score</th>
              </tr>
            </thead>
            <tbody>
              <% if (studentData && studentData.Tasks && studentData.Tasks.length > 0) { %>
                <% studentData.Tasks.forEach(taskObj => { %>
                  <tr>
                    <td><%= taskObj.name %></td>
                    <td><%= taskObj.weight || 'N/A' %></td>
                    <td><%= taskObj.Score.score %></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="3" class="text-center text-muted">No scores available.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <a href="/student/rescue" class="btn btn-warning mt-3">Deploy Rescue Flare</a>

    </div>

    <%- include('../partials/footer') %>